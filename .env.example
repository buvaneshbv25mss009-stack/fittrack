# ==============================================================================
# GYMPORTAL - Root Environment Reference
# Tagline: Train Better. Track Smarter.
# ==============================================================================
# Copy frontend/.env.example to frontend/.env for Frontend configuration.
# Copy backend/.env.example to backend/.env for Backend configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Prefix with VITE_)
# Location: frontend/.env
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Backend Environment Variables
# Location: backend/.env
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Supabase API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String (Direct access via Supabase pooler / direct port)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
